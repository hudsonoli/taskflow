# Copie para .env e preencha os valores reais. Este arquivo (.env.example) é versionado
# e NUNCA deve conter segredos reais.

APP_NAME="Taskfloww API"
APP_ENV=development

# Fuso oficial da aplicação — fonte única do "agora" de negócio (app/core/relogio.py).
# Define o ano gravado em codigo_referencia (D26000001): um registro criado às 23:30 de
# 31/12 em São Paulo pertence ao ano corrente, não ao ano seguinte em UTC. Validado no boot.
APP_TIMEZONE=America/Sao_Paulo

# Postgres (usado tanto pelo docker-compose quanto pelo DATABASE_URL abaixo)
POSTGRES_DB=taskfloww
POSTGRES_USER=taskfloww
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://taskfloww:troque-esta-senha@localhost:5433/taskfloww

# Banco isolado exclusivamente para a suíte de testes (backend/tests) — nunca o de
# desenvolvimento acima. O nome do banco precisa ser exatamente "taskfloww_test"
# (validado em tests/fixtures/database.py) e a URL precisa ser diferente de DATABASE_URL.
DATABASE_URL_TEST=postgresql+psycopg://taskfloww:troque-esta-senha@localhost:5433/taskfloww_test

# Autenticação
AUTH_SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Empresa padrão usada nos scripts de seed
EMPRESA_CODIGO=DEMO
EMPRESA_NOME="Agência Demo"

# Conta de sistema (bootstrap/recuperação) — genérica, sem nome de pessoa hardcoded no código.
# Preencha com os dados reais só no .env (nunca neste arquivo .example nem em código versionado).
BOOTSTRAP_OWNER_NAME="Nome da conta de sistema"
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_PASSWORD="defina-uma-senha-forte"

# Senha inicial padrão para os usuários migrados do mock — obrigatória a troca no primeiro acesso.
# Vale para todas as contas migradas de uma vez, então é uma credencial COMPARTILHADA:
# defina só no .env (gitignored) e rotacione depois que todos tiverem trocado a própria senha.
BOOTSTRAP_DEFAULT_PASSWORD="defina-uma-senha-forte"
